<h1 class="mb-4 fw-bold">Add New Employee</h1>

<form action="/employees" method="POST">
  <div class="mb-3">
    <label for="name" class="form-label fw-bold">Employee Name</label>
    <input type="text" class="form-control" id="name" name="name" placeholder="Enter full name" required>
  </div>

  <div class="mb-3">
    <label for="position" class="form-label fw-bold">Position</label>
    <input type="text" class="form-control" id="position" name="position" placeholder="Enter job title" required>
  </div>

  <div class="mb-3">
    <label for="department" class="form-label fw-bold">Department</label>
    <input type="text" class="form-control" id="department" name="department" placeholder="Enter department name" required>
  </div>

  <div class="mb-3">
    <label for="hireDate" class="form-label fw-bold">Hire Date</label>
    <input type="date" class="form-control" id="hireDate" name="hireDate" required>
  </div>

  <button type="submit" class="btn btn-success">Save Employee</button>
  <a href="/employees" class="btn btn-secondary ms-2">Cancel</a>
</form>
