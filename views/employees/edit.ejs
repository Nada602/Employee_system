<h2>Edit Employee</h2>

<form action="/employees/<%= employee._id %>?_method=PUT" method="POST">
 <div class="mb-3 form-group">
    <label class="form-label fw-bold">Name</label>
  <input class="form-control" type="text" name="name" value="<%= employee.name %>" required />
</div>
<div class="mb-3">
  <label class="form-label fw-bold">Salary</label>
  <input class="form-control" type="number" name="salary" value="<%= employee.salary %>" required />
</div>
<div class="mb-3">
  <label class="form-label fw-bold">Address</label>
  <input class="form-control" type="text" name="department" value="<%= employee.address %>" required />
</div>
<div class="mb-3">
  <label class="form-label fw-bold">Gender</label>
  <input class="form-control" type="text" name="Gender" value="<%= employee.gender %>" required />
</div>
  <button type="submit">Update</button>
</form>
